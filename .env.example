# Copie para .env (gitignored) e ajuste: cp .env.example .env
# Gere uma chave com: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
POSTGRES_PASSWORD=troque-esta-senha
FERNET_KEY=troque-pela-saida-do-comando-acima
# UID do dono do repo (evita arquivos root no volume montado). Descubra com: id -u
AIRFLOW_UID=1000
DQ_SCHEMA=cliente
